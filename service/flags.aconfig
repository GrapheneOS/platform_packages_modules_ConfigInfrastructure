package: "com.android.server.deviceconfig"
container: "com.android.configinfrastructure"

flag {
  name: "use_descriptive_log_message"
  namespace: "core_experiments_team_internal"
  description: "Log sticky local override instead of just local override."
  bug: "335493775"
  metadata {
    purpose: PURPOSE_BUGFIX
  }
}

flag {
    name: "read_only_flag_for_test"
    namespace: "performance"
    description: "Read-only flag for perf testing."
    is_fixed_read_only: true
    bug: "447177427"
}

flag {
    name: "read_write_flag_for_test"
    namespace: "performance"
    description: "Read/write flag for perf testing."
    bug: "447177427"
}
