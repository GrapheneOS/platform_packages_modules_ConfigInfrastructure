package {
    default_team: "trendy_team_android_core_experiments",
    default_applicable_licenses: ["Android-Apache-2.0"],
}

rust_protobuf {
    name: "libaflags_rust_proto",
    crate_name: "aflags_rust_proto",
    source_stem: "aflags_rust_proto_source",
    protos: [
        "aflags.proto",
    ],
    host_supported: true,
    min_sdk_version: "34",
    apex_available: [
        "com.android.configinfrastructure",
        "//apex_available:platform",
    ],
}

rust_defaults {
    name: "aflags_protos.defaults",
    edition: "2024",
    clippy_lints: "android",
    lints: "android",
    srcs: ["src/lib.rs"],
    rustlibs: [
        "libaflags_rust_proto",
        "libanyhow",
        "libprotobuf",
    ],
    min_sdk_version: "34",
}

rust_library {
    name: "libaflags_protos_rust",
    crate_name: "aflags_protos",
    defaults: ["aflags_protos.defaults"],
    host_supported: true,
    apex_available: [
        "com.android.configinfrastructure",
        "//apex_available:platform",
    ],
}
